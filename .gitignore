# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ===== dependencies =====
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===== testing / coverage =====
/coverage
/playwright-report
/test-results
/blob-report
*.lcov

# ===== next.js / build =====
/.next/
/out/
/build
/dist
.turbo
.next
.open-next
.wrangler

# ===== cloudflare =====
.dev.vars*
!.dev.vars.example

# ===== env & secrets =====
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ===== vercel / deploy =====
.vercel

# ===== typescript / tooling caches =====
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== OS / editor =====
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.cursor/
*.swp
*.swo
*~

# ===== local / temp artifacts =====
.tmp/
.tmp-shots/
tmp/
temp/
*.tmp
*.temp
.cache/

# ===== uploaded user files (local/dev) — keep folder =====
public/uploads/*
!public/uploads/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep

# ===== design exports / mockups (not needed to run the app) =====
design/stitch/
*.psd
*.fig
*.sketch

# ===== sample / fixture binaries =====
test/data/

# ===== misc generated =====
*.map
.parcel-cache
.sass-cache
.gstack/
