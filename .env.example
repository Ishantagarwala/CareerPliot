# --- Required ---
AUTH_SECRET=generate_with_openssl_rand_base64_32
MONGODB_URI=mongodb+srv://...

LLM_ROUTER_API_KEY=
LLM_ROUTER_BASE_URL=https://your-router.example.com/v1
LLM_ROUTER_MODEL=zeus/claude-opus-5
LLM_ROUTER_FALLBACK_MODEL=posiden/deepseek-v4-flash

NEXT_PUBLIC_SITE_URL=https://www.careerpilot.cc

# Google Search Console — paste the content= value from the HTML tag method
# GOOGLE_SITE_VERIFICATION=

# --- Optional ---
# hCaptcha (login / register) — https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Auth hardening: reject when IP reputation lookup fails (default: allow on lookup failure)
# IP_REPUTATION_STRICT=true
# Optional ProxyCheck key for stronger VPN/datacenter detection — https://proxycheck.io
# PROXYCHECK_API_KEY=

# YouTube course cards — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Voice (AI Hub) — Sarvam
SARVAM_AI_API_KEY=

# Jobs
# RAPIDAPI_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# PDF OCR fallback
# PDF_CO_API_KEY=

# Local AI / Ollama Configuration
# Set USE_LOCAL_OLLAMA to true to use local AI or fallback to it
USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
OLLAMA_FALLBACK_MODEL=llama3

