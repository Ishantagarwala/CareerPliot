# Auth
AUTH_SECRET=generate_with_openssl_rand_base64_32
MONGODB_URI=mongodb+srv://...

# Public site URL for SEO (sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.careerpilot.cc

# --- LLM router (required — OpenAI-compatible) ---
LLM_ROUTER_API_KEY=
LLM_ROUTER_BASE_URL=https://your-router.example.com/v1
LLM_ROUTER_MODEL=zeus/claude-opus-5
NEXT_PUBLIC_LLM_ROUTER_MODEL=zeus/claude-opus-5
# Fast/cheap fallback (PDF + when flagship unavailable)
LLM_ROUTER_FALLBACK_MODEL=posiden/deepseek-v4-flash
LLM_ROUTER_PDF_MODEL=posiden/deepseek-v4-flash
# Optional AI Hub presets
# LLM_ROUTER_OPUS_MODEL=zeus/claude-opus-5
# LLM_ROUTER_GEMINI_MODEL=ares/glm-5.2
# Set true only if your router supports response_format=json_object
# LLM_ROUTER_JSON_MODE=false

# --- Course providers (optional) ---
# YouTube Data API v3 — enables real long-form video course cards
# Enable API: https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Create key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Abuse protection (hCaptcha) ---
# https://dashboard.hcaptcha.com
# Captcha is OFF unless both enforce flags are true (avoids blocking login when
# hCaptcha rate-limits or fails). Keys alone do not enforce.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# NEXT_PUBLIC_HCAPTCHA_ENFORCE=true
# HCAPTCHA_ENFORCE=true
# HCAPTCHA_FORCE_IN_DEV=true

# Emergency: block all new signups (demo@careerpilot.com still allowed)
# DISABLE_REGISTRATION=true

# Max LLM calls per user per hour across all AI routes
# LLM_USER_HOURLY_LIMIT=25

# Demo account email (bypasses captcha)
# DEMO_EMAIL=demo@careerpilot.com
