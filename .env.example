# --- Required ---
AUTH_SECRET=generate_with_openssl_rand_base64_32
MONGODB_URI=mongodb+srv://...

LLM_ROUTER_API_KEY=
LLM_ROUTER_BASE_URL=https://your-router.example.com/v1
LLM_ROUTER_MODEL=zeus/claude-opus-5
LLM_ROUTER_FALLBACK_MODEL=posiden/deepseek-v4-flash

NEXT_PUBLIC_SITE_URL=https://careerpilot.cc

# Google Search Console — paste the content= value from the HTML tag method
# GOOGLE_SITE_VERIFICATION=

# --- Optional ---
# hCaptcha (login / register) — https://dashboard.hcaptcha.com
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Auth hardening: reject when IP reputation lookup fails (default: allow on lookup failure)
# IP_REPUTATION_STRICT=true
# Optional ProxyCheck key for stronger VPN/datacenter detection — https://proxycheck.io
# PROXYCHECK_API_KEY=

# Demo account (demo@careerpilot.com / demo1234) — bypasses captcha + IP checks.
# OFF by default; enable ONLY on throwaway/demo deployments.
# DEMO_MODE=true
# DEMO_EMAIL=demo@careerpilot.com

# YouTube course cards — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Voice (AI Hub) — Sarvam
SARVAM_AI_API_KEY=

# Jobs
# RAPIDAPI_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# PDF OCR fallback
# PDF_CO_API_KEY=

# Optional secondary OpenAI-compatible router (e.g. Groq free tier). Tried
# after the LLM_ROUTER_* providers and before local Ollama. The correctly
# spelled OLLAMA_ROUTER_* variants are also accepted.
OLAMA_ROUTER_API_KEY=
OLAMA_ROUTER_BASE_URL=https://api.groq.com/openai/v1
OLAMA_ROUTER_MODEL=
OLAMA_ROUTER_FALLBACK_MODEL=

# Optional local Ollama fallback (does not replace LLM_ROUTER_*)
# Set USE_LOCAL_OLLAMA=true to try a local model after the configured router
USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
OLLAMA_FALLBACK_MODEL=


# --- Server-only (docker compose / Caddy) ---
# Public IP of the deploy server; interpolated into the Caddyfile's
# raw-IP redirect (http://{$VPS_IP}). Set in the SERVER-side .env —
# never commit the real value.
VPS_IP=

# Set true ONLY when all traffic arrives via Cloudflare proxy (orange cloud).
# Makes getClientIp() trust CF-Connecting-IP for rate limits / IP checks.
# TRUST_CF_CONNECTING_IP=true
