[Unit]
Description=CareerPilot pull-based deploy (pulls the GHCR image, swaps the container)
Documentation=https://github.com/Ishantagarwala/CareerPliot/blob/main/scripts/vps/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=user
WorkingDirectory=/opt/careerpliot
ExecStart=/opt/careerpliot-deploy/pull-deploy.sh
# The very first pull downloads the full image (~1.5 GB); later ticks are
# manifest checks or changed layers only. Swaps themselves take seconds.
TimeoutStartSec=1200
Nice=10
